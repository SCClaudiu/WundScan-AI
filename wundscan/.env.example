# WundScan AI — Provider-Konfiguration
# Kopiere diese Datei als .env und passe die Werte an.

# Provider: "ollama" oder "claude"
PROVIDER=ollama

# Ollama-Einstellungen
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Claude-Einstellungen (nur wenn PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514
